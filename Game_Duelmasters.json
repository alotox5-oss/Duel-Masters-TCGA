{
  "name": "Duel Masters",
  "menuBackgroundImage": "https://static.wikia.nocookie.net/duelmastersplays/images/3/36/Duel_Masters_PLAY%27S_Visual_Custom.png/revision/latest/scale-to-width-down/1000?cb=20220406063103",

  "cards": {
    "dataUrl": "https://raw.githubusercontent.com/alotox5-oss/Duel-Masters-TCGA/main/CardList%20(6).json",
    "cardBack": "https://upload.wikimedia.org/wikipedia/en/thumb/b/b2/Duel_Masters_cardback.jpg/250px-Duel_Masters_cardback.jpg"
  },

  "deckBuilding": {
    "mainFilters": [
      "Creatures",
      "Evolution creatures",
      "Spell"
    ],
    "formats": []
  },

  "gameplay": {
    "Classic": {
      "mulligan": {
        "startingHandSize": 5,
        "drawNewHand": true,
        "putSelectionAtBottom": true,
        "drawNewSelectedCards": false
      },

      "beforeGameStart": {
        "initialBoardSetup": [
          {
            "drawFromTop": "deck",
            "count": 5,
            "destination": "Shield"
          }
        ]
      },

      "newTurn": {
        "drawOnStart": true,
        "drawPerTurn": 1,
        "resetActions": [
          "playMana"
        ]
      },

      "sections": {
        "customSections": [
          "Battlefield",
          "Mana",
          "Shield",
          "Graveyard",
          "deck"
        ],

        "layout": {
          "direction": "column",
          "isSymetricalForOpponents": false,
          "content": [
            { "section": "Battlefield" },
            { "section": "Mana" },
            { "section": "Shield" },
            { "section": "Graveyard" },
            { "section": "deck" }
          ]
        },

        "autoPlayFromHand": {
          "playMana": {
            "destination": "Mana",
            "maxPerTurn": 1,
            "orientation": 180
          },
          "playCreature": {
            "destination": "Battlefield"
          }
        },

        "sectionsDict": {
          "Battlefield": {
            "title": "Zone de Combat",
            "isHidden": false,
            "isHorizontalAllowed": true,
            "enterTapped": false
          },

          "Mana": {
            "title": "Mana",
            "displayedTitle": "Ressources",
            "isHidden": false,
            "enterTapped": false,
            "enterSpun": true,
            "keepTappedNewTurn": true,
            "isHorizontalAllowed": false
          },

          "Shield": {
            "title": "Shields",
            "isHidden": true,
            "isHorizontalAllowed": false,
            "allowMoveToHand": true,
            "allowManualFlip": true
          },

          "Graveyard": {
            "title": "Cimetière",
            "isHidden": false,
            "isHorizontalAllowed": false
          },

          "deck": {
            "title": "Deck",
            "isHidden": true,
            "isHorizontalAllowed": false
          }
        }
      }
    }
  }
}
